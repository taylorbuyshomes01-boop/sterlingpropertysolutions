# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Twilio — Console > Account Info / Verify > Services
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000

# Meta Pixel + Conversions API (server-side events).
# Pixel ID: Events Manager > Data sources > your pixel. Also paste it into META_PIXEL_ID at the top of public/tracking.js.
# Token: Events Manager > your pixel > Settings > Conversions API > Generate access token
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional: the "Test Events" code from Events Manager to see server events live.
# REMOVE this before real traffic — events sent with a test code don't count toward optimization.
META_TEST_EVENT_CODE=

# GoHighLevel inbound webhooks for THIS site only (one per funnel step).
GHL_WEBHOOK_FORM=
GHL_WEBHOOK_VERIFY=
GHL_WEBHOOK_SURVEY=
GHL_STAGE_SECRET=

ADMIN_KEY=
SESSION_SECRET=
